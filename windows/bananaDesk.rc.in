1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/bananaDesk.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x0000003fL
FILEFLAGS 0
FILEOS 0x00040004L
FILETYPE 0x00000001L
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "bananaDesk Remote Desktop\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "bananaDesk\0"
      VALUE "OriginalFilename", "bananaDesk.exe\0"
      VALUE "ProductName", "bananaDesk\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
